rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // AUTHENTICATION AND ROLE HELPERS
    // =========================================

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath());
    }

    function hasRole(roleName) {
      return currentUserExists()
        && currentUser().data.role == roleName;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isRider() {
      return hasRole("rider");
    }

    function isCustomer() {
      return hasRole("customer");
    }

    // =========================================
    // USERS
    // =========================================

    match /users/{uid} {

      // A user can read their own profile.
      // Admins and riders can read profiles needed by staff screens.
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
          || isRider()
        );

      // Customer self-registration.
      // Staff accounts should be created/promoted by a trusted admin process.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "customer"
        && (
          !request.resource.data.keys().hasAny(["uid"])
          || request.resource.data.uid == request.auth.uid
        );

      allow update: if signedIn()
        && (
          // Preserve the existing admin ability to manage user profiles.
          isAdmin()

          ||

          // Rider can update ONLY their own availability and timestamp.
          // This is needed for Available -> Busy when accepting a pickup,
          // and Busy -> Available when delivering/releasing it.
          (
            request.auth.uid == uid
            && resource.data.role == "rider"
            && request.resource.data.role == "rider"
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "availability",
                "updatedAt"
              ])
            && request.resource.data.availability
              in ["Available", "Busy", "Offline"]
          )

          ||

          // Other users can update only basic profile fields.
          (
            request.auth.uid == uid
            && request.resource.data.get("role", null)
              == resource.data.get("role", null)
            && request.resource.data.get("uid", request.auth.uid)
              == request.auth.uid
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "uid",
                "name",
                "email",
                "phone",
                "availability",
                "updatedAt"
              ])
          )
        );

      allow delete: if isAdmin();
    }

    // =========================================
    // MENU
    // =========================================

    match /menu/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================
    // PRODUCTS (IF USED BY THE APP)
    // =========================================

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================
    // ORDERS
    // =========================================

    match /orders/{orderId} {

      // CUSTOMER CREATES THEIR OWN PENDING ORDER.
      allow create: if signedIn()
        && isCustomer()
        && request.resource.data.customer_id == request.auth.uid
        && request.resource.data.status == "Pending"
        && request.resource.data.keys().hasAll([
          "customer_id",
          "status",
          "items"
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      // READ ACCESS:
      // - Customer: own orders only.
      // - Admin: all orders.
      // - Rider: Ready orders and orders assigned to that rider.
      allow read: if signedIn()
        && (
          (
            isCustomer()
            && resource.data.customer_id == request.auth.uid
          )
          || isAdmin()
          || (
            isRider()
            && resource.data.status == "Ready"
          )
          || (
            isRider()
            && resource.data.get("rider_id", null) == request.auth.uid
          )
        );

      // =======================================
      // ORDER UPDATES
      // =======================================

      allow update: if signedIn()
        && (

          // ADMIN: preserve admin management functionality.
          // The admin dashboard may update status, payment, and order metadata.
          isAdmin()

          ||

          // CUSTOMER CANCELS THEIR OWN PENDING ORDER.
          (
            isCustomer()
            && resource.data.customer_id == request.auth.uid
            && resource.data.status == "Pending"
            && request.resource.data.status == "Cancelled"
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "updatedAt"
              ])
          )

          ||

          // RIDER ACCEPTS A READY ORDER.
          // This matches the app's claim-order transaction:
          // status: Ready -> Accepted
          // rider_id: current Firebase Auth UID
          // rider_name, acceptedAt, updatedAt, changedBy, changedRole.
          (
            isRider()
            && resource.data.status == "Ready"
            && (
              resource.data.get("rider_id", null) == null
              || resource.data.get("rider_id", null) == ""
            )
            && request.resource.data.status == "Accepted"
            && request.resource.data.rider_id == request.auth.uid
            && request.resource.data.changedBy == request.auth.uid
            && request.resource.data.changedRole == "rider"
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "rider_id",
                "rider_name",
                "acceptedAt",
                "updatedAt",
                "changedBy",
                "changedRole"
              ])
          )

          ||

          // RIDER RELEASES AN ACCEPTED ORDER BEFORE HANDOVER.
          // This matches the app's release-order transaction.
          (
            isRider()
            && resource.data.status == "Accepted"
            && resource.data.get("rider_id", null) == request.auth.uid
            && request.resource.data.status == "Ready"
            && request.resource.data.get("rider_id", null) == null
            && request.resource.data.get("rider_name", "") == ""
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "rider_id",
                "rider_name",
                "updatedAt"
              ])
          )

          ||

          // SIMPLIFIED RIDER FLOW: ACCEPTED -> DELIVERED.
          // There is no separate "Start Delivery" action.
          (
            isRider()
            && resource.data.status == "Accepted"
            && resource.data.get("rider_id", null) == request.auth.uid
            && request.resource.data.status == "Received"
            && request.resource.data.get("rider_id", null) == request.auth.uid
            && request.resource.data.changedBy == request.auth.uid
            && request.resource.data.changedRole == "rider"
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "updatedAt",
                "changedBy",
                "changedRole",
                "deliveredAt",
                "receivedAt"
              ])
          )

          ||

          // BACKWARD COMPATIBILITY FOR OLDER ORDERS ALREADY IN DELIVERY.
          (
            isRider()
            && resource.data.status == "Delivery"
            && resource.data.get("rider_id", null) == request.auth.uid
            && request.resource.data.status == "Received"
            && request.resource.data.get("rider_id", null) == request.auth.uid
            && request.resource.data.changedBy == request.auth.uid
            && request.resource.data.changedRole == "rider"
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "updatedAt",
                "changedBy",
                "changedRole",
                "deliveredAt",
                "receivedAt"
              ])
          )
        );

      // ONLY ADMIN CAN DELETE ORDERS.
      allow delete: if isAdmin();
    }

    // =========================================
    // DENY EVERYTHING NOT EXPLICITLY ALLOWED
    // =========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
